# Factory environment — PLACEHOLDERS ONLY.
#
# Copy to `.env` (which is gitignored) and fill in real values locally.
# NEVER commit a real token, key, or password to this file.

# ─────────────────────────────────────────────────────────────────────────────
# CubeSandbox (pre-existing deployment — the factory only consumes it)
# ─────────────────────────────────────────────────────────────────────────────
# This deployment's E2B-compatible API is NOT on the SDK default port 3000.
CUBE_API_URL=http://127.0.0.1:4000

# An existing, READY template. The factory never creates or mutates templates.
# Discover with: cubemastercli tpl list
CUBE_TEMPLATE_ID=tpl-your-ready-template

# Data-plane routing: the SDK dials the proxy node directly and sends
# Host: <port>-<sandboxID>.cube.app
CUBE_PROXY_NODE_IP=192.0.2.10
CUBE_PROXY_PORT_HTTP=80

# Configure your deployment authentication; never commit the credential.
CUBE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Temporal
# ─────────────────────────────────────────────────────────────────────────────
TEMPORAL_HOST_PORT=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=factory

# ─────────────────────────────────────────────────────────────────────────────
# Coding agent harness
# ─────────────────────────────────────────────────────────────────────────────
# Harness name registered in the operator config (never an executable path
# supplied by an API caller).
FACTORY_AGENT=opencode2

# Host path to the pinned, standalone opencode2 binary that the factory pushes
# into each sandbox.
FACTORY_OPENCODE_BINARY=/home/USER/.npm-global/lib/node_modules/@opencode/cli/bin/opencode.exe

# Model the agent uses INSIDE the sandbox. Must be reachable over the sandbox's
# public egress; host-local endpoints are not reachable from a microVM.
FACTORY_OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash

# Operator-provisioned provider credential, passed to the sandbox as an
# environment variable (never as part of the task text). Optional for the
# built-in provider above; required for providers such as github-copilot.
FACTORY_AGENT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Factory storage
# ─────────────────────────────────────────────────────────────────────────────
# Durable artifact storage. Must survive sandbox destruction.
FACTORY_DATA_DIR=.factory

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────
# Set to enable OTLP trace export. Leave empty to disable (traces are no-ops).
FACTORY_OTEL_ENDPOINT=
